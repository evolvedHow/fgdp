# Example environment variables for Metabase + FDP Postgres
#
# Copy to .env.metabase and adjust values if you want to pass DB credentials
# into Metabase via docker compose. Most users will configure data sources
# directly in the Metabase UI instead.

# Local Postgres (the one used for ensemble generation)
LOCAL_POSTGRES_HOST=host.docker.internal
LOCAL_POSTGRES_PORT=5432
LOCAL_POSTGRES_DB=fdga
LOCAL_POSTGRES_USER=homelab
LOCAL_POSTGRES_PASSWORD=homelab

# Supabase session pooler (shared/dashboard target)
SUPABASE_POSTGRES_HOST=aws-0-us-east-1.pooler.supabase.com
SUPABASE_POSTGRES_PORT=5432
SUPABASE_POSTGRES_DB=postgres
SUPABASE_POSTGRES_USER=postgres.jzhxmnjmigfhggzfcwkv
SUPABASE_POSTGRES_PASSWORD=fairdistrictsGA2026!
