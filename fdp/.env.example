# Fair Districts Data Platform — environment variables
# Copy to .env and fill in your values.

# Root directory of the data platform (defaults to the fdp/ project root)
FDP_ROOT=/home/vgana/codebox/fgdp/fdp

# Activate a workspace (overrides app config `app.repo`)
# FDP_WORKSPACE=my_test_shapes

# Census API key — required for fetch_demographics.py
# Get one at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# LLM providers (used by fdga-chain; override in app configs if needed)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434
