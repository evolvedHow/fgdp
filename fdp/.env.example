# FDP environment configuration
# Copy to .env and fill in your values.  Never commit .env to git.

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local Docker (docker compose up -d postgres):
DATABASE_URL=postgresql://fdp:fdp_local@localhost:5432/fdp

# Supabase (replace with your project pooler URL from Settings → Database):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Path to the FDP data directory (where data/repos/main/ lives).
FDP_ROOT=/home/vgana/codebox/fgdp/fdp

# ── Optional ──────────────────────────────────────────────────────────────────

# Override the data mount path in docker compose (defaults to ./data).
# FDP_DATA_PATH=/mnt/data/fdp

# Active workspace (workspace-based overrides)
# FDP_WORKSPACE=
